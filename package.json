{
  "name": "mini-claude-code",
  "version": "0.1.0",
  "description": "A local code agent CLI with tool calling, guarded command execution, diagnostics-driven validation, and session resume.",
  "type": "module",
  "bin": {
    "mini-claude-code": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tches-git/Mini-Code-Agent.git"
  },
  "homepage": "https://github.com/Tches-git/Mini-Code-Agent#readme",
  "bugs": {
    "url": "https://github.com/Tches-git/Mini-Code-Agent/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "code-agent",
    "llm",
    "openai",
    "typescript"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "chat": "tsx src/cli/index.ts -i",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "start:chat": "node dist/cli/index.js -i",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx src/cli/index.ts benchmark",
    "init": "tsx src/cli/index.ts init",
    "doctor": "tsx src/cli/index.ts doctor",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.3.0",
    "openai": "^4.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.17.1",
    "typescript": "^5.5.4",
    "@biomejs/biome": "^2.0.0",
    "vitest": "^4.1.1"
  }
}
